{
  "name": "brand-to-basemap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "dev": "npm run tokens:build && npm run harness:build && vite",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run tokens:build && vitest run",
    "build": "npm run tokens:build && npm run harness:build && npm run lint && npm run typecheck && vite build && node scripts/check-no-keys.mjs",
    "preview": "vite preview",
    "reports": "tsx scripts/generate-reports.ts",
    "styles:fetch": "node scripts/fetch-base-styles.mjs",
    "harness:build": "tsx scripts/build-harness.ts",
    "screens": "node scripts/capture-screens.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.6.1",
    "culori": "^4.0.2",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "^26.5.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "style-dictionary": "^5.7.1",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
